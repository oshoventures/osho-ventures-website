{
  "name": "osho-ventures-website",
  "version": "1.0.0",
  "private": true,
  "description": "Osho Ventures static website",
  "scripts": {
    "start": "serve .",
    "build:css": "npm run build:css:about-us && npm run build:css:book-a-call",
    "build:css:about-us": "tailwindcss -c tailwind/about-us.config.js -i tailwind/input.css -o css/tailwind-about-us.css --minify",
    "build:css:book-a-call": "tailwindcss -c tailwind/book-a-call.config.js -i tailwind/input.css -o css/tailwind-book-a-call.css --minify"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "0.1.1",
    "@tailwindcss/forms": "0.5.10",
    "serve": "^14.2.4",
    "tailwindcss": "3.4.17"
  }
}
